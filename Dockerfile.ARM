# Use an official Ubuntu base image for ARM64 for reproducible builds
FROM arm64v8/ubuntu:26.04

# Set DEBIAN_FRONTEND to noninteractive to prevent prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install all system dependencies required for the base OS and for building our dependencies
RUN apt-get update && apt-get upgrade -y

RUN apt-get install -y software-properties-common ca-certificates && \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc-16 \
    g++-16 \
    git \
    wget \
    unzip \
    curl \
    pkg-config \
    nasm \
    libtiff6 \
    libturbojpeg0-dev \
    # OpenCV Dependencies
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libuvc-dev \
    libxvidcore-dev \
    libx264-dev \
    libgtk-3-dev \
    libopenblas-dev \
    liblapack-dev \
    gfortran \
    # WPILib Dependencies
    libudev-dev \
    libprotobuf-dev \
    protobuf-compiler \
    # Python and Debugging
    python3-dev \
    python3-pip \
    python3-numpy \
    gdb \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    libzstd-dev \
    file \
    && rm -rf /var/lib/apt/lists/*

# Install any pip packages needed
RUN python3 -m pip install --no-cache-dir --break-system-packages \
    cmake==4.4.5 requests==2.34.2 protobuf==7.36.2 grpcio-tools==1.85.3

ENV CC=gcc-16 CXX=g++-16

# Set a temporary working directory for building our dependencies
WORKDIR /opt

# --- Build and Install OpenCV ---
ARG OPENCV_VERSION="5.1.0"
RUN git clone --depth 1 --branch ${OPENCV_VERSION} https://github.com/opencv/opencv.git && \
    git clone --depth 1 --branch ${OPENCV_VERSION} https://github.com/opencv/opencv_contrib.git

RUN mkdir /opt/opencv/build
WORKDIR /opt/opencv/build

# Configure the OpenCV build
RUN cmake -D CMAKE_BUILD_TYPE=RELEASE \
          -D CMAKE_INSTALL_PREFIX=/usr/local \
          -D OPENCV_EXTRA_MODULES_PATH=/opt/opencv_contrib/modules \
          -D BUILD_opencv_features=ON \
          -D BUILD_opencv_flann=ON \
          -D BUILD_EXAMPLES=OFF \
          -D BUILD_TESTS=OFF \
          -D BUILD_DOCS=OFF \
          -D BUILD_opencv_python3=OFF \
          -D WITH_TBB=ON \
          -D WITH_V4L=ON \
          -D WITH_FFMPEG=ON \
          -D WITH_GSTREAMER=ON \
          -D WITH_OPENGL=ON \
          ..
# Compile and install
RUN make -j$(nproc)
RUN make install

# --- Build and Install AprilTag ---
WORKDIR /opt
ARG APRILTAG_VERSION="v3.4.5"
RUN git clone --depth 1 --branch ${APRILTAG_VERSION} https://github.com/AprilRobotics/apriltag.git

RUN mkdir /opt/apriltag/build
WORKDIR /opt/apriltag/build

# Configure, compile, and install AprilTag
RUN cmake -D CMAKE_INSTALL_PREFIX=/usr/local -D CMAKE_C_STANDARD=99 ..
RUN make -j$(nproc)
RUN make install

# --- Build and Install WPILib ---
WORKDIR /opt
ARG WPILIB_VERSION="v2027.0.0-alpha-8"
RUN git clone --depth 1 --branch ${WPILIB_VERSION} https://github.com/wpilibsuite/allwpilib.git

RUN mkdir /opt/allwpilib/build
WORKDIR /opt/allwpilib/build

RUN cmake -D CMAKE_BUILD_TYPE=Release \
          -D CMAKE_INSTALL_PREFIX=/usr/local \
          -D CMAKE_CXX_FLAGS=-Wno-error=array-bounds \
          -DWPILIB_WITH_CSCORE=ON \
          -DWPILIB_WITH_NTCORE=ON \
          -DWPILIB_WITH_WPIMATH=ON \
          -DWPILIB_WITH_FIELDS=ON \
          -DWPILIB_WITH_SIMULATION_MODULES=OFF \
          -DWPILIB_WITH_WPILIB=OFF \
          -DWPILIB_WITH_TESTS=OFF \
          -DWPILIB_WITH_EXAMPLES=OFF \
          -DWPILIB_WITH_BENCHMARK=OFF \
          -DWPILIB_WITH_EXECUTABLES=OFF \
          -DWPILIB_WITH_GUI=OFF \
          ..
# Compile and install
RUN make -j$(nproc)
RUN make install

# --- Build and Install OpenPnP-Capture ---
WORKDIR /opt
ARG OPENPNP_CAPTURE_VERSION="v0.0.30"
RUN git clone --depth 1 --branch ${OPENPNP_CAPTURE_VERSION} https://github.com/openpnp/openpnp-capture.git

RUN mkdir /opt/openpnp-capture/build
WORKDIR /opt/openpnp-capture/build

# Configure, compile, and install
# OpenPnP still declares CMake 3.1; CMake 4 requires a policy floor of 3.5.
RUN cmake -D CMAKE_POLICY_VERSION_MINIMUM=3.5 -D CMAKE_INSTALL_PREFIX=/usr/local ..
RUN make -j$(nproc)
RUN make install

# --- Install Nlohmann-json ---
WORKDIR /usr/local/include/nlohmann
ARG NLOHMANN_JSON_VERSION="v3.12.0"
RUN curl -fL -o json.hpp https://github.com/nlohmann/json/releases/download/${NLOHMANN_JSON_VERSION}/json.hpp

# --- Compile and build cpp-httplib
WORKDIR /opt

ARG CPP_HTTPLIB_VERSION="v0.67.0"
RUN git clone --depth 1 --branch ${CPP_HTTPLIB_VERSION} https://github.com/yhirose/cpp-httplib.git && \
    cd cpp-httplib && \
    mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=/usr/local \
          .. && \
    make -j$(nproc) && \
    make install

# --- Final Cleanup ---
# Clean up the source directories to reduce the final image size
# Also run ldconfig to update the linker cache for the newly installed libraries
RUN rm -rf /opt/opencv /opt/opencv_contrib /opt/apriltag /opt/allwpilib /opt/openpnp-capture /opt/Eigen
RUN ldconfig

# --- Create a non-root user for security ---
# Switch to the non-root user for subsequent commands and for running the container
RUN useradd -ms /bin/bash developer
USER developer

# Set the final working directory for the developer user
WORKDIR /home/developer/workspace
